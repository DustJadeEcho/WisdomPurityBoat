export function pickRandomExamples(count: number): string[] {
  const list: string[] = [...AI_EXAMPLE_PROMPTS];
  for (let i = list.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const temp = list[i];
    list[i] = list[j];
    list[j] = temp;
  }
  return list.slice(0, Math.min(count, list.length));
}
